# ==========================================================================
# SECRETS TEMPLATE — copy this file to `secrets.toml` (same folder) and fill in
# your real Turso values. `secrets.toml` is gitignored, so it never gets
# committed. THIS .example file is safe to commit (it has no real values).
#
# WHAT THESE ARE:
#   TURSO_DATABASE_URL — the address of your Turso database (starts libsql://).
#                        Get it with:  turso db show <db-name> --url
#   TURSO_AUTH_TOKEN   — a secret password that lets the app read the database.
#                        Get it with:  turso db tokens create <db-name>
#
# LOCAL DEV: You do NOT need this file at all for normal local work — with no
# secrets present, the app opens the local ../../db/applications.db instead.
# Fill this in only when you want to TEST the Turso path on your machine.
#
# DEPLOYED (Streamlit Cloud): do NOT upload this file. Instead paste the same
# two lines into the app's Settings -> Secrets box on share.streamlit.io.
# ==========================================================================

TURSO_DATABASE_URL = "libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "paste-your-auth-token-here"
